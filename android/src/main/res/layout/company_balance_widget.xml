<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/balance_widget_container"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_wallet" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Şirket Bakiyesi"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_on_surface" />

        <ImageView
            android:id="@+id/balance_visibility_toggle"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:scaleType="center"
            android:src="@drawable/ic_eye_off" />
    </LinearLayout>

    <TextView
        android:id="@+id/balance_company_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:textColor="@color/widget_on_surface_variant"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="ABC Ticaret A.Ş." />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/widget_divider"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Borç"
            android:textSize="12sp"
            android:textColor="@color/widget_on_surface_variant" />
        <TextView
            android:id="@+id/balance_debit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_negative"
            tools:text="264.199,96 ₺" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Alacak"
            android:textSize="12sp"
            android:textColor="@color/widget_on_surface_variant" />
        <TextView
            android:id="@+id/balance_credit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_positive"
            tools:text="3.150,00 ₺" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nakit"
            android:textSize="12sp"
            android:textColor="@color/widget_on_surface_variant" />
        <TextView
            android:id="@+id/balance_cash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_on_surface"
            tools:text="263.900,00 ₺" />
    </LinearLayout>

    <TextView
        android:id="@+id/balance_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Detaylar için dokun ›"
        android:textSize="11sp"
        android:textColor="@color/widget_muted" />

    </LinearLayout>

    <!-- Görünmez dokunma alanı: göz ikonunun üstüne, satır yüksekliklerini
         değiştirmeden bindirilmiş büyük hit-area. LinearLayout akışının
         dışında olduğu için diğer satırları itmez. Negatif marginTop/End,
         konteynerin 14dp padding'ini iptal edip bu alanı widget'ın gerçek
         sağ üst köşesine kadar uzatıyor — köşeye yapılan dokunuşlar artık
         "uygulamayı aç"a değil buraya denk geliyor. -->
    <ImageView
        android:id="@+id/balance_visibility_toggle_hitarea"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="-14dp"
        android:layout_marginEnd="-14dp"
        android:layout_gravity="top|end" />

</FrameLayout>
