        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:textColor="@color/widget_on_surface_variant"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="ABC Ticaret A.Ş." />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/widget_divider"
        android:text="" />

    <LinearLayout
        android:id="@+id/son_item1_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/son_item1_arrow_badge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_arrow_badge_out">
            <TextView
                android:id="@+id/son_item1_arrow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_positive"
                tools:text="↑" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/son_item1_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textColor="@color/widget_on_surface"
                tools:text="Kaya Ticaret Ltd. Şti." />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/son_item1_status_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:background="@drawable/widget_status_pill_purple"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_accent"
                    tools:text="Taslak" />
                <TextView
                    android:id="@+id/son_item1_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="10sp"
                    android:textColor="@color/widget_muted"
                    tools:text="23.09.2026" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/son_item1_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_on_surface"
            tools:text="1.250,00 ₺" />
    </LinearLayout>

